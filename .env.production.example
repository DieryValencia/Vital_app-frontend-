# VitalApp Frontend - Environment variables (Production)
# IMPORTANTE: Renombra este archivo a .env.production y completa los valores
# NUNCA subas .env.production (con valores reales) a Git

# API Configuration
# Reemplaza con tu URL de backend en Railway
VITE_API_URL=http://localhost:8080

# Google Maps API Key (si necesitas mapas)
VITE_GOOGLE_MAPS_API_KEY=

# Debug mode - desactivar en producción
VITE_DEBUG=false
